<div id="drinax-root">
  <div class="dr-header">
    <p class="dr-title">Pirates of <span>Drinax</span></p>
    <p class="dr-subtitle">Faction &amp; world tracker &mdash; Trojan Reach campaign log</p>
    <div class="dr-summary" data-dr-summary></div>
    <div class="dr-pri-row">
      <label for="dr-pri-input">Piracy Response Indicator (PRI)</label>
      <button type="button" class="dr-pri-btn" data-dr-pri-dec>&minus;</button>
      <input type="number" id="dr-pri-input" data-dr-pri>
      <button type="button" class="dr-pri-btn" data-dr-pri-inc>+</button>
    </div>
  </div>

  <div class="dr-tabs">
    <button type="button" class="dr-tab active" data-dr-tab="factions">Factions</button>
    <button type="button" class="dr-tab" data-dr-tab="contacts">Contacts</button>
    <button type="button" class="dr-tab" data-dr-tab="worlds">Worlds</button>
    <button type="button" class="dr-tab" data-dr-tab="log">Log</button>
  </div>

  <div class="dr-toolbar">
    <input type="text" class="dr-search" data-dr-search placeholder="Search...">
    <button type="button" class="dr-btn" data-dr-add>+ Add</button>
    <div class="dr-filters" data-dr-filters></div>
  </div>

  <div class="dr-grid" data-dr-grid></div>
  <div class="dr-empty" data-dr-empty style="display:none;"></div>
</div>
