<div class="drinax-tracker-wrapper">
<style>
  #drinax-root {
    --bg: #0b0f17;
    --panel: #141b28;
    --panel-alt: #1b2432;
    --border: #2b3548;
    --text: #dfe4ec;
    --text-muted: #8892a3;
    --gold: #c9a24a;
    --red: #c1443c;
    --orange: #d98b3f;
    --teal: #4fb0a6;
    --slate: #8a90a0;
    --imperium: #5b7fa6;
    --aslan: #bf6a3f;
    --pirate: #a33d3d;
    --other: #5c8a86;

    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    height: 100%;
    padding: 16px;
    box-sizing: border-box;
    overflow-y: auto;
  }
  #drinax-root * { box-sizing: border-box; }
  #drinax-root .mono { font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace; }

  #drinax-root .dr-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 14px;
  }
  #drinax-root .dr-title {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin: 0 0 4px;
    color: var(--text);
  }
  #drinax-root .dr-title span { color: var(--gold); }
  #drinax-root .dr-subtitle {
    color: var(--text-muted);
    font-size: 12.5px;
    margin: 0;
  }

  #drinax-root .dr-summary {
    margin-top: 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  #drinax-root .dr-summary-chip {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11px;
    padding: 5px 9px;
    border-radius: 3px;
    background: var(--panel-alt);
    border: 1px solid var(--border);
    color: var(--text-muted);
    white-space: nowrap;
  }
  #drinax-root .dr-summary-chip b { color: var(--text); font-weight: 700; }

  #drinax-root .dr-tabs {
    margin-top: 16px;
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
  }
  #drinax-root .dr-tab {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 12.5px;
    padding: 8px 4px;
    margin-right: 20px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  #drinax-root .dr-tab:hover { color: var(--text); }
  #drinax-root .dr-tab.active { color: var(--gold); border-bottom-color: var(--gold); }

  #drinax-root .dr-toolbar {
    margin-top: 12px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  #drinax-root .dr-search {
    flex: 1 1 160px;
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 7px 10px;
    border-radius: 4px;
    font-size: 12.5px;
  }
  #drinax-root .dr-search:focus { outline: none; border-color: var(--gold); }
  #drinax-root .dr-btn {
    font-family: inherit;
    background: var(--gold);
    color: #14100a;
    border: none;
    padding: 7px 14px;
    border-radius: 4px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  #drinax-root .dr-btn:hover { filter: brightness(1.08); }
  #drinax-root .dr-btn-ghost {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  #drinax-root .dr-btn-ghost:hover { color: var(--text); border-color: var(--text-muted); }

  #drinax-root .dr-filters {
    margin-top: 10px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  #drinax-root .dr-filter-chip {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  #drinax-root .dr-filter-chip.active { border-color: currentColor; }

  #drinax-root .dr-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 10px;
  }

  #drinax-root .dr-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-left: 3px solid var(--cat-color, var(--border));
    border-radius: 5px;
    padding: 12px 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  #drinax-root .dr-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  #drinax-root .dr-card-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }
  #drinax-root .dr-card-tag {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 10px;
    color: var(--cat-color, var(--text-muted));
    white-space: nowrap;
  }
  #drinax-root .dr-badge {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 10.5px;
    padding: 2px 8px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text);
    background: var(--panel-alt);
    border: 1px solid var(--border);
    width: fit-content;
  }
  #drinax-root .dr-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--dot-color, var(--slate));
    flex-shrink: 0;
  }
  #drinax-root .dr-card-uwp {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11.5px;
    color: var(--gold);
  }
  #drinax-root .dr-card-meta {
    font-size: 11.5px;
    color: var(--text-muted);
  }
  #drinax-root .dr-card-notes {
    font-size: 12.5px;
    color: var(--text);
    line-height: 1.45;
    white-space: pre-wrap;
    margin: 0;
  }
  #drinax-root .dr-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  #drinax-root .dr-tag-pill {
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 9px;
    background: var(--panel-alt);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  #drinax-root .dr-card-actions {
    display: flex;
    gap: 8px;
    margin-top: 2px;
  }
  #drinax-root .dr-icon-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 11px;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    cursor: pointer;
    padding: 2px 0;
  }
  #drinax-root .dr-icon-btn:hover { color: var(--text); }
  #drinax-root .dr-icon-btn.danger:hover { color: var(--red); }

  #drinax-root .dr-empty {
    margin: 30px auto;
    text-align: center;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  /* Drawer */
  #drinax-root .dr-overlay {
    position: absolute; inset: 0;
    background: rgba(4,6,10,0.6);
    display: none;
    z-index: 40;
  }
  #drinax-root .dr-overlay.open { display: block; }
  #drinax-root .dr-drawer {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 340px; max-width: 100%;
    background: var(--panel);
    border-left: 1px solid var(--border);
    z-index: 41;
    padding: 18px;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.2s ease;
  }
  #drinax-root .dr-drawer.open { transform: translateX(0); }
  #drinax-root .dr-drawer h3 {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 15px;
    margin: 0 0 14px;
    color: var(--gold);
  }
  #drinax-root .dr-field { margin-bottom: 12px; }
  #drinax-root .dr-field label {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  #drinax-root .dr-field input,
  #drinax-root .dr-field select,
  #drinax-root .dr-field textarea {
    width: 100%;
    background: var(--panel-alt);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 7px 9px;
    border-radius: 4px;
    font-size: 12.5px;
    font-family: inherit;
  }
  #drinax-root .dr-field textarea { resize: vertical; min-height: 60px; }
  #drinax-root .dr-field select { padding: 12px 9px; }
  #drinax-root .dr-field input:focus,
  #drinax-root .dr-field select:focus,
  #drinax-root .dr-field textarea:focus {
    outline: none; border-color: var(--gold);
  }
  #drinax-root .dr-field-readonly {
    color: var(--text-muted) !important;
    cursor: default;
  }
  #drinax-root .dr-drawer-actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }

  #drinax-root .dr-pri-row {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #drinax-root .dr-pri-row label {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11px;
    color: var(--text-muted);
  }
  #drinax-root .dr-pri-row input {
    width: 70px;
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--gold);
    font-weight: 700;
    padding: 5px 8px;
    border-radius: 4px;
    font-size: 13px;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  #drinax-root .dr-pri-row input:focus { outline: none; border-color: var(--gold); }
</style>

<div id="drinax-root">
  <div class="dr-header">
    <p class="dr-title">Pirates of <span>Drinax</span></p>
    <p class="dr-subtitle">Faction &amp; world tracker &mdash; Trojan Reach campaign log</p>
    <div class="dr-summary" data-dr-summary></div>
    <div class="dr-pri-row">
      <label for="dr-pri-input">Piracy Response Indicator (PRI)</label>
      <input type="number" id="dr-pri-input" data-dr-pri>
    </div>
  </div>

  <div class="dr-tabs">
    <button type="button" class="dr-tab active" data-dr-tab="factions">Factions</button>
    <button type="button" class="dr-tab" data-dr-tab="contacts">Contacts</button>
    <button type="button" class="dr-tab" data-dr-tab="worlds">Worlds</button>
  </div>

  <div class="dr-toolbar">
    <input type="text" class="dr-search" data-dr-search placeholder="Search...">
    <button type="button" class="dr-btn" data-dr-add>+ Add</button>
    <button type="button" class="dr-btn dr-btn-ghost" data-dr-reset>Reset data</button>
  </div>

  <div class="dr-filters" data-dr-filters></div>

  <div class="dr-grid" data-dr-grid></div>
  <div class="dr-empty" data-dr-empty style="display:none;"></div>

  <div class="dr-overlay" data-dr-overlay>
    <div class="dr-drawer" data-dr-drawer>
      <div data-dr-drawer-content></div>
    </div>
  </div>
</div>
</div>
